{
  "info": {
    "name": "BetappaBharath Banking API TestLab",
    "description": "A ready-to-run collection for the live BetappaBharath Banking API TestLab. Generate an access token first, then practise customer, account, transaction and transfer APIs without running a local server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://betappabharath-api-testlab.bharathbetappa.workers.dev", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "customerId", "value": "CUST-1001", "type": "string" },
    { "key": "primaryAccountId", "value": "ACC-5001", "type": "string" },
    { "key": "secondaryAccountId", "value": "ACC-5002", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Create access token",
          "auth": { "type": "noauth" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.test('Token and expiry are returned', () => { pm.expect(json.access_token).to.be.a('string'); pm.expect(json.expires_in).to.eql(900); pm.expect(json.expires_in_unit).to.eql('seconds'); pm.expect(json.expires_in_minutes).to.eql(15); pm.expect(json.expires_at).to.be.a('string'); });", "pm.collectionVariables.set('accessToken', json.access_token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"learner@example.test\",\n  \"password\": \"practice-password\",\n  \"expires_in\": 900\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/auth/token",
            "description": "Creates a Bearer token against the live API and saves it automatically as accessToken. expires_in uses seconds, not milliseconds: 900 = 15 minutes, 1800 = 30 minutes, 2700 = 45 minutes, and 3600 = 1 hour."
          }
        }
      ]
    },
    {
      "name": "02 - Customers",
      "item": [
        {
          "name": "List all customers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/customers", "description": "Returns all customers created using the current Bearer token's isolated practice session." }
        },
        {
          "name": "Create customer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.collectionVariables.set('customerId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Betappa\",\n  \"middleName\": \"\",\n  \"lastName\": \"Bharath\",\n  \"dateOfBirth\": \"2000-07-17\",\n  \"isMinorCustomer\": false,\n  \"gender\": \"M\",\n  \"birthCountry\": \"IN\",\n  \"nationality\": \"IN\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/customers",
            "description": "Creates a customer and saves the returned ID as customerId."
          }
        },
        { "name": "Get one customer", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/customers/{{customerId}}" } },
        {
          "name": "Replace customer details",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Betappa\",\n  \"middleName\": \"\",\n  \"lastName\": \"Bharath\",\n  \"dateOfBirth\": \"2000-07-17\",\n  \"isMinorCustomer\": false,\n  \"gender\": \"M\",\n  \"birthCountry\": \"IN\",\n  \"nationality\": \"IN\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/v1/customers/{{customerId}}"
          }
        },
        { "name": "Delete customer", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/customers/{{customerId}}", "description": "Returns 204 after every active account belonging to the customer has been deleted." } }
      ]
    },
    {
      "name": "03 - Accounts",
      "item": [
        {
          "name": "Create primary account",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.collectionVariables.set('primaryAccountId', json.data.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"accountType\": \"savings\",\n  \"nickname\": \"Salary Account\",\n  \"openingBalance\": 10000\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/customers/{{customerId}}/accounts" }
        },
        {
          "name": "Create secondary account",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.collectionVariables.set('secondaryAccountId', json.data.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"accountType\": \"savings\",\n  \"nickname\": \"Travel Fund\",\n  \"openingBalance\": 0\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/customers/{{customerId}}/accounts" }
        },
        { "name": "List customer accounts", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/customers/{{customerId}}/accounts" } },
        { "name": "Get account details", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/accounts/{{primaryAccountId}}" } },
        { "name": "Rename secondary account", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nickname\": \"Emergency Fund\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/accounts/{{secondaryAccountId}}" } },
        { "name": "Delete secondary account", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/accounts/{{secondaryAccountId}}", "description": "Returns 204 only when the account balance is zero." } }
      ]
    },
    {
      "name": "04 - Transactions and transfers",
      "item": [
        { "name": "Deposit money", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"type\": \"credit\",\n  \"amount\": 2500,\n  \"reference\": \"Salary credit\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/accounts/{{primaryAccountId}}/transactions" } },
        { "name": "Withdraw money", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"type\": \"debit\",\n  \"amount\": 1500,\n  \"reference\": \"Cash withdrawal\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/accounts/{{secondaryAccountId}}/transactions" } },
        { "name": "Transfer money", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fromAccountId\": \"{{primaryAccountId}}\",\n  \"toAccountId\": \"{{secondaryAccountId}}\",\n  \"amount\": 1500\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/transfers" } },
        { "name": "View transactions", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/accounts/{{primaryAccountId}}/transactions" } }
      ]
    },
    {
      "name": "05 - Advanced HTTP errors",
      "item": [
        {
          "name": "403 - Forbidden scope",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));", "pm.test('Required scope is explained', () => pm.expect(pm.response.json().required_scope).to.eql('admin:write'));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/status/403", "description": "Uses a valid Bearer token that lacks the admin:write permission." }
        },
        {
          "name": "405 - Method not allowed",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 405', () => pm.response.to.have.status(405));", "pm.test('Allow header is returned', () => pm.expect(pm.response.headers.get('Allow')).to.eql('GET, POST'));"] } }],
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/v1/status/405", "description": "Sends an unsupported HTTP method and returns an Allow response header." }
        },
        {
          "name": "415 - Unsupported media type",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 415', () => pm.response.to.have.status(415));", "pm.test('Accepted media type is explained', () => pm.expect(pm.response.json().accepted).to.include('application/json'));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "text/plain" }], "body": { "mode": "raw", "raw": "firstName=Betappa" }, "url": "{{baseUrl}}/api/v1/status/415", "description": "Sends text/plain to an endpoint that accepts application/json." }
        },
        {
          "name": "429 - Too many requests",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 429', () => pm.response.to.have.status(429));", "pm.test('Retry and limit headers are returned', () => { pm.expect(pm.response.headers.get('Retry-After')).to.eql('30'); pm.expect(pm.response.headers.get('X-RateLimit-Remaining')).to.eql('0'); });"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/status/429", "description": "Simulates a rate-limited request and returns Retry-After and X-RateLimit headers." }
        },
        {
          "name": "503 - Service unavailable",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 503', () => pm.response.to.have.status(503));", "pm.test('Retry-After is returned', () => pm.expect(pm.response.headers.get('Retry-After')).to.eql('60'));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/status/503", "description": "Simulates temporary banking-service maintenance and advises the client when to retry." }
        }
      ]
    },
    {
      "name": "06 - API defect simulator",
      "item": [
        {
          "name": "Healthy baseline",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Completed status is returned', () => pm.expect(pm.response.json().data.status).to.eql('completed'));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"defect\": \"baseline\",\n  \"attempt\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/simulator" }
        },
        {
          "name": "500 - Simulated server error",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 500', () => pm.response.to.have.status(500));", "pm.test('Request ID is returned', () => pm.expect(pm.response.json().requestId).to.be.a('string'));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"defect\": \"server-error\",\n  \"attempt\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/simulator" }
        },
        {
          "name": "429 - Simulated rate limit",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 429', () => pm.response.to.have.status(429));", "pm.test('Retry-After is 30 seconds', () => pm.expect(pm.response.headers.get('Retry-After')).to.eql('30'));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"defect\": \"rate-limit\",\n  \"attempt\": 1\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/simulator" }
        }
      ]
    }
  ]
}
